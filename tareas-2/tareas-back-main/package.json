{
  "name": "api-tareas",
  "version": "1.0.0",
  "description": "Base profesional inicial para una API de tareas con Express",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "pnpm run build && node --test --test-concurrency=1 tests/*.test.js",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage --test-concurrency=1 tests/*.test.js",
    "backup-db": "node dist/scripts/backupDb.js",
    "normalizar-etiquetas": "node dist/scripts/normalizarEtiquetas.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "init-db": "node dist/scripts/initDb.js",
    "init-db:force": "node dist/scripts/initDb.js --force",
    "keycloak:up": "docker compose up -d",
    "keycloak:down": "docker compose down",
    "keycloak:setup": "bash scripts/setup-keycloak.sh",
    "test:production": "pnpm run build && node scripts/check-production.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.type-tests.json",
    "dev:types": "tsc -p tsconfig.json --watch",
    "migrate-db": "node dist/scripts/migrateDb.js",
    "restore-db": "node dist/scripts/restoreDb.js"
  },
  "keywords": [
    "node",
    "express",
    "api",
    "backend",
    "tareas"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
